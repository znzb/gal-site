{
  "buildCommand": "node node_modules/vite/bin/vite.js build",
  "outputDirectory": "dist",
  "framework": null,
  "installCommand": "npm install",
  "devCommand": "npm run dev",
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.galzb.cc.cd" }], "destination": "https://galzb.cc.cd/:path*", "permanent": true }
  ],
  "routes": [
    { "src": "/admin(.*)", "dest": "/admin.html" },
    { "src": "/assets/(.*)", "dest": "/assets/$1" },
    { "src": "/banners/(.*)", "dest": "/banners/$1" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
